# syntax=docker/dockerfile:1
#
# Streaming container: runs the actual desktop JVM game against a virtual X
# display inside the container, and streams the display + audio to the
# browser over WebSocket via KasmVNC. Users upload their redneck.grp
# through a landing page; the game starts once it lands in /data.

# ---------- Stage 1: build the fat jar ----------
FROM eclipse-temurin:17-jdk-jammy AS build

WORKDIR /src

COPY gradle/ ./gradle/
COPY gradlew settings.gradle build.gradle gradle.properties ./
RUN chmod +x ./gradlew && ./gradlew --version --no-daemon

COPY buildgdx-core/    ./buildgdx-core/
COPY buildgdx-lwjgl3/  ./buildgdx-lwjgl3/
COPY core/             ./core/
COPY desktop/          ./desktop/
COPY html/             ./html/
COPY external/         ./external/
COPY scripts/          ./scripts/

RUN sh ./scripts/patch-vendored.sh

RUN ./gradlew :desktop:shadowJar --no-daemon
RUN mv desktop/build/libs/desktop-*-all.jar /tmp/game.jar

# ---------- Stage 2: streaming runtime ----------
FROM eclipse-temurin:17-jre-jammy

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:1
ENV HOME=/root

# Base system + KasmVNC deps.
#
# KasmVNC is a TigerVNC fork by Kasm Technologies purpose-built for
# containerised browser sessions. It bundles a noVNC-fork HTML5 client
# with mouse-capture and WebSocket-audio channels — no wrestling with
# Xpra auth semantics or missing jquery.
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget \
        ca-certificates \
        curl \
        # Runtime deps for the game
        libopenal1 \
        libglu1-mesa \
        libgl1-mesa-dri \
        mesa-utils \
        # Window management (KasmVNC replaces Xvfb entirely; we still
        # need a WM inside the session so the game window is placed
        # and can be forced fullscreen)
        fluxbox \
        xdotool \
        wmctrl \
        # Front-end
        nginx \
        python3 \
        inotify-tools \
        # Audio: pulseaudio + gstreamer pipeline. KasmVNC's audio path
        # captures PulseAudio via `gst-launch-1.0 pulsesrc` and streams
        # Opus frames over a WebSocket to the browser.
        pulseaudio \
        pulseaudio-utils \
        gstreamer1.0-tools \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-pulseaudio \
        # KasmVNC runtime deps
        xauth \
        libjpeg-turbo8 \
        libxfont2 \
        libxdmcp6 \
        libxkbfile1 \
        libtinfo6 \
        libssl3 \
        libpixman-1-0 \
        libavcodec58 \
        libavutil56 \
        libswscale5 \
        libxcursor1 \
        libxi6 \
        libxinerama1 \
        libxrandr2 \
        libxtst6 \
        libgbm1 \
        libgomp1 \
        libpciaccess0 \
        libdrm2 \
    && wget -q -O /tmp/kasmvnc.deb \
        https://github.com/kasmtech/KasmVNC/releases/download/v1.3.4/kasmvncserver_jammy_1.3.4_amd64.deb \
    && apt-get install -y --no-install-recommends /tmp/kasmvnc.deb \
    && rm /tmp/kasmvnc.deb \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/rrgdx /data /root/.vnc

COPY --from=build /tmp/game.jar /opt/rrgdx/game.jar

COPY scripts/container-start.sh   /opt/rrgdx/container-start.sh
COPY scripts/wait-and-launch.sh   /opt/rrgdx/wait-and-launch.sh
COPY scripts/upload_server.py     /opt/rrgdx/upload_server.py
COPY scripts/nginx.conf           /etc/nginx/nginx.conf
COPY scripts/kasmvnc.yaml         /root/.vnc/kasmvnc.yaml
COPY html/webapp/index.html       /opt/rrgdx/landing/index.html

RUN chmod +x /opt/rrgdx/container-start.sh /opt/rrgdx/wait-and-launch.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s CMD curl -sf http://localhost:8080/healthz >/dev/null || exit 1

ENTRYPOINT ["/opt/rrgdx/container-start.sh"]
